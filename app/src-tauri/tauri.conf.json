{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintForge",
  "version": "0.4.1",
  "identifier": "dev.printforge.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrintForge",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/printforge-geo"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMjFBMjRFMTNCQjgxQTQKUldTa2dic1RUcUlobXVqdlZ0Z0pUamtBMnJocWxlZEZtTC9SZk5HSjVtTHRYZUFlKzRlM2xBRUEK",
      "endpoints": [
        "https://github.com/yakut-sekonts/printforge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
