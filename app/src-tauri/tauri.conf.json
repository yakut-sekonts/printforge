{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintForge",
  "version": "0.0.1",
  "identifier": "dev.printforge.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrintForge — пробная сборка M0",
        "width": 1100,
        "height": 750
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/printforge-geo"]
  }
}
