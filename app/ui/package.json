  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.5"
